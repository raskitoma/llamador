# Caddyfile — single-port front door for the whole stack.
#
# Default site is HTTP on :80 inside the container, mapped to :${CADDY_PORT}
# on the host (default 8088). Swap to your domain + auto-TLS by editing the
# site address — Caddy will fetch a Let's Encrypt cert automatically.

{
    auto_https off          # disable until you give Caddy a real domain
    admin off
    servers {
        protocols h1 h2 h2c
    }
}

:80 {
    # WebSocket upgrade pass-through is automatic in Caddy v2.

    # /api/* → backend (FastAPI). WebSockets included.
    # `handle` (not `handle_path`) so the /api prefix reaches the backend —
    # FastAPI registers its routes with the full /api/... path.
    handle /api/* {
        reverse_proxy backend:8000 {
            transport http {
                read_timeout 0
                write_timeout 0
            }
        }
    }

    # /v1/* → backend (so the API-key gate runs). The backend then proxies
    # to llama-engine. If you want to skip the auth hop entirely (LAN-only,
    # no key store), point this directly at llama-engine:8080.
    # Use `handle` (not `handle_path`) so the /v1 prefix reaches the backend
    # — the backend's /v1/{path:path} route expects the full path. The old
    # handle_path + rewrite combo produced "/v1//chat/completions{?}" with a
    # double slash and an unexpanded query placeholder.
    handle /v1/* {
        reverse_proxy backend:8000 {
            transport http {
                read_timeout 0
                write_timeout 0
            }
        }
    }

    # Engine /metrics directly (Prometheus scrape).
    handle_path /metrics {
        reverse_proxy llama-engine:8080
    }

    # WebSocket-bearing API paths. Caddy handles upgrade automatically;
    # we just need to route them. /api/* already does — this block is
    # documentation of the WS endpoints the frontend uses.
    @ws path /api/logs /api/build/* /api/autotune/*/ws
    handle @ws {
        reverse_proxy backend:8000
    }

    # Anything else → static frontend.
    handle {
        reverse_proxy frontend:80
    }

    encode zstd gzip
    log {
        format console
        level INFO
    }
}
