# llamador — copy to `.env` and tweak. Compose reads this automatically.

# ---------- engine knobs (also live-editable from the UI) ------------------
MODEL_FILE=Qwen3.6-35B-A3B-Q4_K_M.gguf
ALIAS=qwen3.6-35b-a3b
NGL=999
N_CPU_MOE=30
CTX=8192
# KV_TYPE: q8_0, q4_0, turbo3, turbo4, …
KV_TYPE=q8_0
FLASH_ATTN=on
THREADS=auto
BATCH=2048
UBATCH=2048
EXTRA_ARGS=

# ---------- build args -----------------------------------------------------
CUDA_VERSION=12.4.1
# CUDA_ARCH: GTX 1080 = Pascal compute 6.1
CUDA_ARCH=61
TURBOQUANT_BRANCH=feature/turboquant-kv-cache

# ---------- paths on the host ----------------------------------------------
MODELS_DIR=./data/models
CONFIG_DIR=./data/config

# ---------- secrets / tokens ----------------------------------------------
# HF_TOKEN: only needed for gated repos
HF_TOKEN=
# API_TOKEN: if set, control panel requires Bearer auth
API_TOKEN=

# ---------- ports ----------------------------------------------------------
CADDY_PORT=8088
OPENWEBUI_PORT=3000
PROM_PORT=9090
GRAFANA_PORT=3001
